<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ITM_Tickets_Global.MauiApp.Pages.LoginPage"
             Title="ITM-Tickets Global"
             BackgroundColor="{StaticResource Primary}">
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
            <Label Text="🎫 ITM-Tickets" FontSize="36" TextColor="White" HorizontalOptions="Center" />
            <Label Text="World Tour 2026" FontSize="16" TextColor="#a8c4dc" HorizontalOptions="Center" />

            <Entry x:Name="UsernameEntry" Placeholder="Usuario (admin o user)" Text="user" BackgroundColor="White" TextColor="Black" />
            <Entry x:Name="PasswordEntry" Placeholder="Contraseña" Text="user123" IsPassword="True" BackgroundColor="White" TextColor="Black" />

            <Button x:Name="LoginButton" Text="Ingresar" Clicked="OnLoginClicked"
                    BackgroundColor="{StaticResource Accent}" TextColor="White" CornerRadius="8" />

            <Label x:Name="StatusLabel" TextColor="#ffd5b3" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
